pipeline {
    agent any

    environment {
        REGISTRY = 'docker.io/your-dockerhub-username'  // Change this to your Docker Hub username
    }

    options {
        skipDefaultCheckout true
    }

    stages {
        stage('Pull stage') {
            steps {
                git url: 'https://github.com/your-username/bb-Healthapp-sourcecode.git', branch: 'main'
            }
        }

        stage('Build') {
            steps {
                echo "Building Docker images for BBHealthApp..."
                
                // Build Master Service
                dir('bbhealthapp-backend/bbhealthapp-api-master') {
                    sh 'docker build -t ${REGISTRY}/bbhealthapp-master-service:latest .'
                }
                
                // Build Register Service
                dir('bbhealthapp-backend/bbhealthapp-api-register') {
                    sh 'docker build -t ${REGISTRY}/bbhealthapp-register-service:latest .'
                }
                
                // Build Document Service
                dir('bbhealthapp-backend/bbhealthapp-api-document') {
                    sh 'docker build -t ${REGISTRY}/bbhealthapp-document-service:latest .'
                }
                
                // Build Frontend
                dir('bbhealthapp-frontend') {
                    sh 'docker build -t ${REGISTRY}/bbhealthapp-frontend:latest .'
                }
            }
        }

        stage('Push stage') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                }
                
                sh 'docker push ${REGISTRY}/bbhealthapp-master-service:latest'
                sh 'docker push ${REGISTRY}/bbhealthapp-register-service:latest'
                sh 'docker push ${REGISTRY}/bbhealthapp-document-service:latest'
                sh 'docker push ${REGISTRY}/bbhealthapp-frontend:latest'
            }
        }

        stage('Deploy') {
            steps {
                echo "Deploying BBHealthApp containers..."
                
                // Stop existing containers
                sh 'docker stop bbhealthapp-master bbhealthapp-register bbhealthapp-document bbhealthapp-frontend || true'
                sh 'docker rm bbhealthapp-master bbhealthapp-register bbhealthapp-document bbhealthapp-frontend || true'

                // Create network if not exists
                sh 'docker network create bbhealthapp-network || true'

                // Run Master Service (port 8081 based on Dockerfile)
                sh 'docker run -d --name bbhealthapp-master --network bbhealthapp-network -p 8081:8081 ${REGISTRY}/bbhealthapp-master-service:latest'

                // Wait for master service to be ready
                sh 'sleep 30'

                // Run Register Service
                sh 'docker run -d --name bbhealthapp-register --network bbhealthapp-network -p 8082:8080 ${REGISTRY}/bbhealthapp-register-service:latest'

                // Wait for register service to be ready
                sh 'sleep 20'

                // Run Document Service
                sh 'docker run -d --name bbhealthapp-document --network bbhealthapp-network -p 8083:8080 ${REGISTRY}/bbhealthapp-document-service:latest'

                // Wait for document service to be ready
                sh 'sleep 20'

                // Run Frontend
                sh 'docker run -d --name bbhealthapp-frontend --network bbhealthapp-network -p 80:80 ${REGISTRY}/bbhealthapp-frontend:latest'
            }
        }

        stage('Verify') {
            steps {
                echo "Verifying deployment..."
                sh 'docker ps'
                sh 'curl -f http://localhost:80 || echo "Frontend check failed"'
                sh 'curl -f http://localhost:8081 || echo "Master service check failed"'
                sh 'curl -f http://localhost:8082 || echo "Register service check failed"'
                sh 'curl -f http://localhost:8083 || echo "Document service check failed"'
            }
        }
    }

    post {
        success {
            echo "BBHealthApp deployment completed successfully!"
        }
        failure {
            echo "BBHealthApp deployment failed. Check logs for details."
        }
    }
}
