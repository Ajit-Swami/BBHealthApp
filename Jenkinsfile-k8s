pipeline {
    agent any

    environment {
        REGISTRY = 'docker.io/your-dockerhub-username'  // Change this to your Docker Hub username
        KUBECONFIG = '/home/jenkins/.kube/config'  // Path to kubeconfig on Jenkins agent
    }

    options {
        skipDefaultCheckout true
    }

    stages {
        stage('Pull stage') {
            steps {
                git url: 'https://github.com/your-username/bb-Healthapp-sourcecode.git', branch: 'main'
            }
        }

        stage('Build') {
            steps {
                echo "Building Docker images for BBHealthApp..."
                
                // Build Master Service
                dir('bbhealthapp-backend/bbhealthapp-api-master') {
                    sh 'docker build -t ${REGISTRY}/bbhealthapp-master-service:latest .'
                }
                
                // Build Register Service
                dir('bbhealthapp-backend/bbhealthapp-api-register') {
                    sh 'docker build -t ${REGISTRY}/bbhealthapp-register-service:latest .'
                }
                
                // Build Document Service
                dir('bbhealthapp-backend/bbhealthapp-api-document') {
                    sh 'docker build -t ${REGISTRY}/bbhealthapp-document-service:latest .'
                }
                
                // Build Frontend
                dir('bbhealthapp-frontend') {
                    sh 'docker build -t ${REGISTRY}/bbhealthapp-frontend:latest .'
                }
            }
        }

        stage('Push stage') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                }
                
                sh 'docker push ${REGISTRY}/bbhealthapp-master-service:latest'
                sh 'docker push ${REGISTRY}/bbhealthapp-register-service:latest'
                sh 'docker push ${REGISTRY}/bbhealthapp-document-service:latest'
                sh 'docker push ${REGISTRY}/bbhealthapp-frontend:latest'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo "Deploying to Kubernetes cluster..."
                
                dir('kubernetes') {
                    // Update image references in deployment files
                    sh """
                        sed -i 's|image: .*bbhealthapp-master-service.*|image: ${REGISTRY}/bbhealthapp-master-service:latest|g' master-service-deployment.yaml
                        sed -i 's|image: .*bbhealthapp-register-service.*|image: ${REGISTRY}/bbhealthapp-register-service:latest|g' register-service-deployment.yaml
                        sed -i 's|image: .*bbhealthapp-document-service.*|image: ${REGISTRY}/bbhealthapp-document-service:latest|g' document-service-deployment.yaml
                        sed -i 's|image: .*bbhealthapp-frontend.*|image: ${REGISTRY}/bbhealthapp-frontend:latest|g' frontend-deployment.yaml
                    """
                    
                    // Apply Kubernetes manifests
                    sh 'kubectl apply -f namespace.yaml'
                    sh 'kubectl apply -f configmap.yaml'
                    sh 'kubectl apply -f secret.yaml'
                    sh 'kubectl apply -f pvc.yaml'
                    sh 'kubectl apply -f master-service-deployment.yaml'
                    sh 'kubectl apply -f register-service-deployment.yaml'
                    sh 'kubectl apply -f document-service-deployment.yaml'
                    sh 'kubectl apply -f frontend-deployment.yaml'
                    sh 'kubectl apply -f ingress.yaml'
                    
                    // Wait for deployments to be ready
                    sh 'kubectl rollout status deployment/master-service -n bbhealthapp --timeout=300s'
                    sh 'kubectl rollout status deployment/register-service -n bbhealthapp --timeout=300s'
                    sh 'kubectl rollout status deployment/document-service -n bbhealthapp --timeout=300s'
                    sh 'kubectl rollout status deployment/frontend -n bbhealthapp --timeout=300s'
                }
            }
        }

        stage('Verify') {
            steps {
                echo "Verifying Kubernetes deployment..."
                sh 'kubectl get pods -n bbhealthapp'
                sh 'kubectl get services -n bbhealthapp'
                sh 'kubectl get ingress -n bbhealthapp'
            }
        }
    }

    post {
        success {
            echo "BBHealthApp deployment to Kubernetes completed successfully!"
        }
        failure {
            echo "BBHealthApp deployment failed. Check logs for details."
        }
    }
}
